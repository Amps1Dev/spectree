# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# LLM Provider
# Which model backend the app uses by default: "ollama" (local) or "groq" (cloud).
# The sidebar toggle overrides this per-browser; this governs first load / fallback.
DEFAULT_LLM_PROVIDER=ollama

# Local model via Ollama (no API key needed). Matches the cdeception project.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Groq cloud API (only needed if you select/ default to the Groq provider)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
