# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Groq API Configuration
GROQ_API_KEY=your-groq-api-key

# Optional server-enforced scope (comma-separated hosts, *.domains, or CIDRs).
# Loopback, unspecified, and link-local targets are always blocked.
# SPECTRE_TARGET_SCOPE=192.0.2.0/24,*.example.test
# SPECTRE_TARGET_BLOCKLIST=192.0.2.42
# SPECTRE_APP_SCOPE=com.example.app,1234
# SPECTRE_APP_BLOCKLIST=com.example.excluded

# Local inputs/output are limited to these real directories; default: project root.
# Standard /usr/share/wordlists is also allowed for credential-audit wordlists.
# SPECTRE_TOOL_ROOTS=/absolute/path/to/spectree/data
# SPECTRE_TOOL_PATH_BLOCKLIST=/absolute/path/to/private-data
# SPECTRE_TOOL_OUTPUT_DIR=/absolute/path/to/spectree/data/tool-output

# MobSF server; dynamic mode also needs its configured test device/emulator.
# SPECTRE_MOBSF_URL=http://127.0.0.1:8000
# SPECTRE_MOBSF_API_KEY=your-mobsf-api-key
# SPECTRE_MOBSF_DYNAMIC_SECONDS=30
# SPECTRE_MOBSF_IOS_DEVICE_ID=your-jailbroken-ios-device-id

# Burp Suite Professional: enable its built-in REST API and an API key.
# The URL is the server root, without the API key or /v0.1 suffix.
# SPECTRE_BURP_URL=http://127.0.0.1:1337
# SPECTRE_BURP_API_KEY=your-burp-api-key

# Nessus REST API and an existing scan policy ID supplied with each request.
# SPECTRE_NESSUS_URL=https://127.0.0.1:8834
# SPECTRE_NESSUS_ACCESS_KEY=your-access-key
# SPECTRE_NESSUS_SECRET_KEY=your-secret-key
# SPECTRE_NESSUS_TEMPLATE_UUID=optional-template-uuid
# For private CA certificates, set NODE_EXTRA_CA_CERTS in the launch environment.

# Optional executable overrides (otherwise searched in PATH and standard bin dirs).
# SPECTRE_NMAP_BIN=/usr/bin/nmap
# SPECTRE_NIKTO_BIN=/usr/bin/nikto
# SPECTRE_DROZER_BIN=/path/to/drozer
# SPECTRE_FRIDA_BIN=/path/to/frida
# SPECTRE_OBJECTION_BIN=/path/to/objection
# SPECTRE_JADX_BIN=/usr/bin/jadx
# SPECTRE_APKTOOL_BIN=/usr/bin/apktool
# SPECTRE_GHIDRA_BIN=/opt/ghidra/support/analyzeHeadless
# SPECTRE_NUCLEI_BIN=/path/to/nuclei
# SPECTRE_HYDRA_BIN=/usr/bin/hydra
# SPECTRE_ENUM4LINUX_NG_BIN=/usr/bin/enum4linux-ng
# SPECTRE_AUDIT_USERNAME=optional-default-account
